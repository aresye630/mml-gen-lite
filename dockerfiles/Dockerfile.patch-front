    grep -q "_diagnose_hermes_failure" /opt/expgv/backend/app.py; \
    grep -q "何时出产物" /opt/expgv/backend/app.py; \
    \
    echo "[patch] 容器内 agent 通用 memory 就位（且不含局点/客户数据）…"; \
    test -f /home/expgv/.hermes/memories/MEMORY.md; \
    ! grep -qE "FSUPFm[0-9]|GZUPFm[0-9]|XAUPF[0-9]|/Users/|ares\.ye|arestse|expgv-multi" /home/expgv/.hermes/memories/MEMORY.md; \
    \
