    cd /opt/expgv/tools && python3 verify_remote_consistency.py --selftest >/dev/null; \
    echo "    verify_remote_consistency 自证通过"; \
    test -f /opt/expgv/docs/容器重建说明.md; \
    test -f /opt/expgv/VERSION.md; \
    grep -q "产品版本: v5" /opt/expgv/VERSION.md; \
    grep -q "操作台功能冒烟" /opt/expgv/scripts/smoke_v5/test_console_smoke.py; \
