{
  "command_name": "STR OFFLOADBYEDGEAMF",
  "command_name_zh": "启动园区内AMF用户迁移任务",
  "command_name_full": "启动园区内AMF用户迁移任务（STR OFFLOADBYEDGEAMF）",
